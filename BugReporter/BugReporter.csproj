<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Hexaverse Bug Reporter. Not part of the default game packages.
    See docs/bug-reporter.md for how to configure it and add it to a release.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationIcon>visual.ico</ApplicationIcon>
    <RootNamespace>BugReporter</RootNamespace>
    <AssemblyName>BugReporter</AssemblyName>
    <Product>Hexaverse Bug Reporter</Product>
    <Copyright>Copyright (c) 2017-2026 Stefan Elsen. MIT License.</Copyright>
    <Version>2.0.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Lets 'dotnet build' compile the project on any OS (for CI checks); it only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Report settings. Empty by default: reports are saved to a file, nothing is uploaded. -->
    <None Update="BugReporter.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
