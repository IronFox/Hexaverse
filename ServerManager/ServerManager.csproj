<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Hexaverse Server Manager. See docs/tools.md.
    The release workflow publishes it as a single self-contained ServerManager.exe,
    so players don't need to install the .NET runtime:
      dotnet publish ServerManager/ServerManager.csproj -c Release -r win-x64 -o ServerManager
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>server_icon_3QL_icon.ico</ApplicationIcon>
    <RootNamespace>ServerManager</RootNamespace>
    <AssemblyName>ServerManager</AssemblyName>
    <Product>Hexaverse Server Manager</Product>
    <Copyright>Copyright (c) 2018-2026 Stefan Elsen. MIT License.</Copyright>
    <Version>2.0.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Lets 'dotnet build' compile the project on any OS (for CI checks); it only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WinForms doesn't support trimming, so the bundle is compressed instead. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Protocol/ is its own project, so keep its sources out of this one. -->
    <Compile Remove="Protocol\**" />
    <EmbeddedResource Remove="Protocol\**" />
    <None Remove="Protocol\**" />
    <ProjectReference Include="Protocol\Protocol.csproj" />
  </ItemGroup>

</Project>
