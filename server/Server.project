<project type="Application:Console" extraProjectOptions="/std:c++latest /Zc:__cplusplus">
	<source path="../clientServerShared" include="true" />
	<source path="../globalShared" include="true" />
	<source path="./" />
	<referenceProject name="DeltaWorksCore" includePath="true" />
	<referenceProject name="lua" includePath="true" />
	<macro name="_SCL_SECURE_NO_WARNINGS" />
	<disableWarning>26439 <!-- noexcept --></disableWarning>
	<includeLibrary name="Steam SDK">
		<include>../steam_sdk</include>
		<linkDirectory if_platform="x32">../steam_sdk/lib/win32</linkDirectory>
		<linkDirectory if_platform="x64">../steam_sdk/lib/win64</linkDirectory>
		<link>Steam_api.lib</link>
		<link>sdkencryptedappticket.lib</link>
	</includeLibrary>
</project>
